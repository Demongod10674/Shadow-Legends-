@charset "utf-8";

* { margin: 0px; padding: 0px; box-sizing: border-box; }

body { font-family: Orbitron, sans-serif; background: linear-gradient(135deg, rgb(4, 8, 22), rgb(18, 5, 43), rgb(36, 16, 95), rgb(7, 28, 79)); color: white; overflow-x: hidden; min-height: 100vh; }

body::before { content: ""; position: fixed; width: 200%; height: 200%; background: radial-gradient(circle, rgba(125, 60, 255, 0.133) 2px, transparent 2px) 0% 0% / 45px 45px; animation: 15s linear 0s infinite normal none running gridMove; z-index: -1; }

@keyframes gridMove { 
  0% { transform: translate(0px, 0px); }
  100% { transform: translate(-100px, -100px); }
}

.particle { position: fixed; width: 5px; height: 5px; background: rgb(123, 224, 255); border-radius: 50%; opacity: 0.4; animation: auto linear 0s infinite normal none running float; }

@keyframes float { 
  0% { transform: translateY(100vh); }
  100% { transform: translateY(-120vh); }
}

header { text-align: center; padding: 40px 20px; background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px); }

header h1 { font-size: 3rem; color: rgb(210, 179, 255); text-shadow: rgb(125, 60, 255) 0px 0px 20px; animation: 2s ease 0s infinite alternate none running glow; }

@keyframes glow { 
  0% { text-shadow: rgb(125, 60, 255) 0px 0px 10px; }
  100% { text-shadow: rgb(125, 60, 255) 0px 0px 25px, rgb(125, 60, 255) 0px 0px 50px; }
}

header p { margin-top: 10px; color: rgb(221, 221, 221); }

.container { width: 100%; display: flex; flex-direction: column; align-items: center; padding: 40px 20px; }

.searchBox { width: 100%; max-width: 950px; display: flex; gap: 12px; }

.searchBox input { flex: 1 1 0%; padding: 18px; border: none; outline: none; border-radius: 15px; background: rgba(255, 255, 255, 0.08); color: white; font-size: 1rem; box-shadow: rgba(125, 60, 255, 0.25) 0px 0px 20px; }

.searchBox input::placeholder { color: rgb(208, 200, 255); }

.searchBox button { padding: 18px 30px; border: none; border-radius: 15px; background: linear-gradient(135deg, rgb(125, 60, 255), rgb(47, 141, 255)); color: white; font-weight: bold; cursor: pointer; transition: 0.3s; }

.searchBox button:hover { transform: scale(1.05); }

.result { width: 100%; max-width: 950px; margin-top: 20px; padding: 30px; border-radius: 25px; background: rgba(255, 255, 255, 0.06); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.1); animation: 1s ease 0s 1 normal none running fade; }

@keyframes fade { 
  0% { opacity: 0; transform: translateY(15px); }
  100% { opacity: 1; transform: translateY(0px); }
}

.result h2 { color: rgb(210, 179, 255); margin-bottom: 20px; }

.result p { line-height: 1.9; color: rgb(236, 232, 255); }

.topicImage { width: 100%; max-height: 450px; object-fit: cover; border-radius: 20px; margin-bottom: 20px; box-shadow: rgba(123, 224, 255, 0.25) 0px 0px 25px; }

.aiBox { width: 100%; max-width: 950px; margin-top: 20px; padding: 25px; border-radius: 20px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); }

.aiBox h3 { color: rgb(123, 224, 255); margin-bottom: 10px; }

footer { text-align: center; padding: 30px; color: rgb(153, 153, 153); }

@media (max-width: 700px) {
  .searchBox { flex-direction: column; }
}
